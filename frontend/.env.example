# =============================================================================
# USMISSIONHERO AI Validator — frontend configuration (EXAMPLE / PLACEHOLDERS)
# =============================================================================
# Copy to `.env.local` for local development and fill with NON-SECRET,
# deployment-specific values. NEVER commit a populated .env / .env.local.
#
# These are PUBLIC, non-secret, build-time values only:
#   - No AWS access/secret/session keys.
#   - No client secret (the Cognito app client is public / no secret).
#   - No account IDs.
#
# All values below are placeholders and are safe to commit in this example file.
# =============================================================================

# Base URL of the AI Validator HTTP API (POST /BedrockPromptHandler).
# Example placeholder only:
VITE_API_BASE_URL=https://api.example.invalid

# Cognito OIDC issuer / authority used for OIDC discovery by oidc-client-ts.
# Format: https://cognito-idp.<region>.amazonaws.com/<userPoolId>
# This CANNOT be derived from the Hosted UI domain; it is a separate value.
# Example placeholder only:
VITE_COGNITO_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_EXAMPLE

# Cognito Hosted UI domain (used for the /logout endpoint).
VITE_COGNITO_DOMAIN=https://auth.example.invalid

# Cognito app client id (public client; NOT a secret).
VITE_COGNITO_CLIENT_ID=example-client-id

# OAuth redirect + logout URIs (must match Cognito app client config).
VITE_COGNITO_REDIRECT_URI=https://ai.usmissionhero.com/callback
VITE_COGNITO_LOGOUT_URI=https://ai.usmissionhero.com/

# Optional OAuth scopes (space-separated). Defaults to "openid email profile".
VITE_COGNITO_SCOPES=openid email profile
