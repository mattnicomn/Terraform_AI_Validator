##############################
# Terraform
##############################
# Local Terraform working directories 
.terraform/
# NOTE: .terraform.lock.hcl is intentionally TRACKED for reproducible provider selection

# Do not commit local terraform binaries
terraform.exe
**/terraform.exe

# CloudFormation templates kept local only
Cloudformation_Template.yml
Cloudformation_TemplateClean.yml


# State files
*.tfstate
*.tfstate.*

# Crash logs
crash.log
crash.*.log

# Sensitive variables
*.tfvars
*.tfvars.json

# Local overrides
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Lock info
.terraform.tfstate.lock.info

# Plan outputs
/tfplan
*.tfplan
*.tfplan.*

# Ignore CLI configs (personal)
.terraformrc
terraform.rc


##############################
# Terraform Modules / Artifacts
##############################
# Compiled Lambda packages
*.zip

# Python cache and bytecode
__pycache__/
*.pyc
*.pyo
*.pyd
*.pytest_cache/

# Node build artifacts (if using Node Lambdas or front-end)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local build outputs
build/
dist/
*.egg-info/

# VSCode and IDE project files
.vscode/
.idea/
*.iml


##############################
# AWS Lambda + Python
##############################
# Virtual environments
.env/
.venv/
env/
venv/
ENV/
Pipfile.lock
poetry.lock

# Lambda deployment artifacts generated locally
lambda_packages/
package/
*.zip
*.egg

# AWS SAM / CDK outputs (if used for local testing)
.aws-sam/
cdk.out/


##############################
# API / OpenAPI Specs
##############################
# Generated API docs or temp exports
openapi_generated.yaml
openapi_generated.json
*.bak
*.tmp
*.swp


##############################
# GitLab CI / Logs / Outputs
##############################
# Terraform artifacts and plan outputs from CI
terraform.tfplan
plan.out
.plan

# GitLab CI local environment files
.env.local
.env.development
.env.production
.env.test

# Coverage / test output
coverage/
test-results/
logs/
*.log


##############################
# System / OS Junk
##############################
.DS_Store
Thumbs.db
desktop.ini


##############################
# Optional: include examples
##############################
# Allow committed examples/templates
!examples/**
!README.md
!docs/**


##############################
# Assets (Optional)
##############################
# Uncomment the lines below if you want to keep assets private
# and not commit them to the repository
# assets/*.png
# assets/*.jpg
# assets/*.jpeg
# assets/*.ico
# assets/*.pdf

# Always track the README
!assets/README.md
!assets/.gitkeep

##############################
# Large media (preserved externally, not in Git history)
##############################
# These are legitimate site assets kept out of ordinary Git history.
# Preserved under C:\USMISSIONHERO\local-only\evidence\terraform-ai-validator\site-assets\
# NOTE: do NOT use broad assets/*.pdf — tracked resume PDFs are intentional project assets.
/assets/The_AI_Data_Validator.mp4
/assets/Terraform_AI_Validator.pdf

##############################
# Frontend (products/ai/frontend) — Phase 5B scaffold
##############################
# Local env files with real (non-secret) deployment values must NOT be committed.
frontend/.env
frontend/.env.local
frontend/.env.*.local
# Build + dependency artifacts (also covered by global rules; explicit for clarity).
frontend/node_modules/
frontend/dist/

# Keep the scaffold's tracked files (guard against broader ignore rules above).
!frontend/package.json
!frontend/package-lock.json
!frontend/.env.example
!frontend/src/
!frontend/src/**
